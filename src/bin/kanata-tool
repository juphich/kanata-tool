#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KANATA_TOOL_HOME="${KANATA_TOOL_HOME:-$(cd "${SCRIPT_DIR}/.." && pwd)}"
export KANATA_TOOL_HOME

COMMANDS_DIR="${KANATA_TOOL_HOME}/commands"

usage() {
  cat <<'EOF'
Usage: kanata-tool <command>

Commands:
  setup      Install kanata binary/config and autostart
  uninstall  Remove kanata binary/config and autostart
  device     Reset runtime config from base config (Linux)
  start      Start kanata service/agent
  stop       Stop kanata service/agent
EOF
}

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

cmd="$1"
shift || true

case "$(uname -s)" in
  Linux) PLATFORM="linux" ;;
  Darwin) PLATFORM="macos" ;;
  *)
    printf '[kanata-tool] Unsupported OS: %s\n' "$(uname -s)" >&2
    exit 1
    ;;
esac

case "${cmd}" in
  uninstall)
    if [[ "${KANATA_TOOL_UNINSTALL_RUNTIME_ONLY:-0}" == "1" ]]; then
      exec bash "${COMMANDS_DIR}/${PLATFORM}/uninstall.sh" "$@"
    fi
    exec bash "${KANATA_TOOL_HOME}/install.sh" --uninstall "$@"
    ;;
  setup|device|start|stop)
    exec bash "${COMMANDS_DIR}/${PLATFORM}/${cmd}.sh" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    printf '[kanata-tool] Unknown command: %s\n' "${cmd}" >&2
    usage >&2
    exit 1
    ;;
esac
